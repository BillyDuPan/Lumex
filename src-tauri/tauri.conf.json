{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lumex",
  "version": "1.0.0",
  "identifier": "com.lumex.visuals",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lumex Pro - Control",
        "url": "index.html",
        "width": 1480,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "focus": true,
        "visible": true
      },
      {
        "label": "projector",
        "title": "Lumex - Output",
        "url": "output.html",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
