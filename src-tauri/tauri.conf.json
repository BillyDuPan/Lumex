{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lumex",
  "version": "1.0.0",
  "identifier": "com.lumex.visuals",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "windows": [
      {
        "title": "Lumex Pro - Control",
        "url": "control.html",
        "width": 1480,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
